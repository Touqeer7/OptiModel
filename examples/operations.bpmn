<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:studio="urn:optimodel:studio:1" id="StudioDefinitions" targetNamespace="urn:optimodel:studio:1">
  <bpmn:process id="Process_operations" name="Resource-constrained operations" isExecutable="false">
    <bpmn:extensionElements>
      <studio:assumption>All durations, staffing and rates are illustrative example assumptions.</studio:assumption>
    </bpmn:extensionElements>
    <bpmn:startEvent id="start" name="Work order received">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="split" name="Release jobs">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="a_short" name="Prepare labels">
      <bpmn:extensionElements>
        <studio:metadata provenance="example" duration="2.0" role="Technician"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="c_chain" name="Calibrate equipment">
      <bpmn:extensionElements>
        <studio:metadata provenance="example" duration="3.0" role="Technician"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="b_independent" name="Run quality inspection">
      <bpmn:extensionElements>
        <studio:metadata provenance="example" duration="7.0" role="Technician"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="d_finish" name="Complete calibrated batch">
      <bpmn:extensionElements>
        <studio:metadata provenance="example" duration="8.0" role="Technician"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="join" name="All jobs complete">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="end" name="Batch released">
      <bpmn:incoming>flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="split" name=""/>
    <bpmn:sequenceFlow id="flow_2" sourceRef="split" targetRef="a_short" name=""/>
    <bpmn:sequenceFlow id="flow_3" sourceRef="split" targetRef="c_chain" name=""/>
    <bpmn:sequenceFlow id="flow_4" sourceRef="split" targetRef="b_independent" name=""/>
    <bpmn:sequenceFlow id="flow_5" sourceRef="c_chain" targetRef="d_finish" name=""/>
    <bpmn:sequenceFlow id="flow_6" sourceRef="a_short" targetRef="join" name=""/>
    <bpmn:sequenceFlow id="flow_7" sourceRef="b_independent" targetRef="join" name=""/>
    <bpmn:sequenceFlow id="flow_8" sourceRef="d_finish" targetRef="join" name=""/>
    <bpmn:sequenceFlow id="flow_9" sourceRef="join" targetRef="end" name=""/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="StudioDiagram">
    <bpmndi:BPMNPlane id="StudioPlane" bpmnElement="Process_operations">
      <bpmndi:BPMNShape id="DI_start" bpmnElement="start">
        <dc:Bounds x="60" y="242.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_split" bpmnElement="split">
        <dc:Bounds x="240" y="236.0" width="48" height="48"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_a_short" bpmnElement="a_short">
        <dc:Bounds x="420" y="104.0" width="120" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_b_independent" bpmnElement="b_independent">
        <dc:Bounds x="420" y="224.0" width="120" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_c_chain" bpmnElement="c_chain">
        <dc:Bounds x="420" y="344.0" width="120" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_d_finish" bpmnElement="d_finish">
        <dc:Bounds x="600" y="344.0" width="120" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_join" bpmnElement="join">
        <dc:Bounds x="780" y="236.0" width="48" height="48"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_end" bpmnElement="end">
        <dc:Bounds x="960" y="242.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_flow_1" bpmnElement="flow_1">
        <di:waypoint x="96" y="260.0"/>
        <di:waypoint x="168.0" y="260.0"/>
        <di:waypoint x="168.0" y="260.0"/>
        <di:waypoint x="240" y="260.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_flow_2" bpmnElement="flow_2">
        <di:waypoint x="288" y="260.0"/>
        <di:waypoint x="354.0" y="260.0"/>
        <di:waypoint x="354.0" y="140.0"/>
        <di:waypoint x="420" y="140.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_flow_3" bpmnElement="flow_3">
        <di:waypoint x="288" y="260.0"/>
        <di:waypoint x="354.0" y="260.0"/>
        <di:waypoint x="354.0" y="380.0"/>
        <di:waypoint x="420" y="380.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_flow_4" bpmnElement="flow_4">
        <di:waypoint x="288" y="260.0"/>
        <di:waypoint x="354.0" y="260.0"/>
        <di:waypoint x="354.0" y="260.0"/>
        <di:waypoint x="420" y="260.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_flow_5" bpmnElement="flow_5">
        <di:waypoint x="540" y="380.0"/>
        <di:waypoint x="570.0" y="380.0"/>
        <di:waypoint x="570.0" y="380.0"/>
        <di:waypoint x="600" y="380.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_flow_6" bpmnElement="flow_6">
        <di:waypoint x="540" y="140.0"/>
        <di:waypoint x="660.0" y="140.0"/>
        <di:waypoint x="660.0" y="260.0"/>
        <di:waypoint x="780" y="260.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_flow_7" bpmnElement="flow_7">
        <di:waypoint x="540" y="260.0"/>
        <di:waypoint x="660.0" y="260.0"/>
        <di:waypoint x="660.0" y="260.0"/>
        <di:waypoint x="780" y="260.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_flow_8" bpmnElement="flow_8">
        <di:waypoint x="720" y="380.0"/>
        <di:waypoint x="750.0" y="380.0"/>
        <di:waypoint x="750.0" y="260.0"/>
        <di:waypoint x="780" y="260.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_flow_9" bpmnElement="flow_9">
        <di:waypoint x="828" y="260.0"/>
        <di:waypoint x="894.0" y="260.0"/>
        <di:waypoint x="894.0" y="260.0"/>
        <di:waypoint x="960" y="260.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
