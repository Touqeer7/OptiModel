# Optional. File import, examples, verification, simulation and optimization need no key.
# Copy to backend/.env and configure a model that your provider actually offers.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://makerend.com/v1

# Legacy Makerend variables are also supported when the corresponding AI_* value is blank.
MAKEREND_API_KEY=
MAKEREND_MODEL=
MAKEREND_BASE_URL=https://makerend.com/v1

# Optional absolute path for local SQLite and run artifacts. Default: repository/data.
# OPTIMODEL_DATA_DIR=
