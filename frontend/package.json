{
  "name": "optimodel-studio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "lint": "biome lint src",
    "format:check": "prettier --check src e2e *.ts *.json index.html"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "bpmn-js": "^18.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
